msgid "<span><b>FLATPAK</b></span>\n\n<span size=\"small\" allow_breaks=\"true\">⚠ Applies overrides to provide flatpak apps access to Gtk configs.\n     Overrides will be removed on disable.\n     Requires 'Apply to Gtk Apps' to be turned On.</span>"
msgstr "<span><b>FLATPAK</b></span>\n\n<span size=\"small\" allow_breaks=\"true\">⚠ 通过覆盖项为 flatpak 应用提供 GTK 配置访问。\n     禁用时覆盖项将被移除。\n     需要先开启「应用到 Gtk 应用」。</span>"

msgid "<span><b>GTK3 / GTK4</b></span>\n\n<span size=\"small\" allow_breaks=\"true\">⚠ It will write to 'gtk.css' under '$XDG_CONFIG_HOME/gtk-3.0/' and 'gtk-4.0'.\n     For existing gtk.css, Open Gnome Box will create a backup and restore it on disable.\n     You are advised to also take a manual backup as a failsafe.</span>"
msgstr "<span><b>GTK3 / GTK4</b></span>\n\n<span size=\"small\" allow_breaks=\"true\">⚠ 会写入 '$XDG_CONFIG_HOME/gtk-3.0/' 与 'gtk-4.0' 下的 'gtk.css'。\n     对于已存在的 gtk.css，Open Gnome Box 会先创建备份，并在禁用时恢复。\n     建议你另外手动备份以防万一。</span>"

